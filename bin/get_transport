#!/bin/bash

set -euo pipefail

TRANSPORT_REF=v0.2.0

os=${1:-$(uname -s)}
arch=${2:-$(uname -m)}

if [ "$os" = "Darwin" ] && [ "$arch" = "arm64" ]; then
  arch="aarch64"
fi

if [ "$os" != "Darwin" ] && [ "$os" != "Linux" ]; then
  echo "Unsupported OS" >&2
  exit 1
fi

if [ "$arch" != "aarch64" ] && [ "$arch" != "x86_64" ]; then
  echo "Unsupported Architecture" >&2
  exit 1
fi

asset="transport-${os}-${arch}.tar.gz"

case "$asset" in
  transport-Darwin-aarch64.tar.gz) expected=7dcaec969378a181a62749673b9c0b658be17bf16a8880f5effbd8e03a6c4a17 ;;
  transport-Darwin-x86_64.tar.gz) expected=ccb9f795086d5584ff605cff8aefc534a82cde3154a3231f7f9396cde27bf7d4 ;;
  transport-Linux-aarch64.tar.gz) expected=cf54fbf596b8a708fbc64e031f98737f076b8c32c371a4506c8141c49bca84be ;;
  transport-Linux-x86_64.tar.gz) expected=87b2d6847ed0efa44c73ec16526b85134bf6f2e3759d99f925682eaf1b27d937 ;;
esac

root="$(cd "$(dirname "$0")/.." && pwd)"
dest="$root/lib/bin"
archive="$root/tmp/$asset"
mkdir -p "$dest" "$root/tmp"
trap 'rm -f "$archive"' EXIT

curl -L --fail --silent --show-error \
  "https://github.com/selectiveci/transport/releases/download/${TRANSPORT_REF}/${asset}" \
  -o "$archive"

if command -v sha256sum >/dev/null 2>&1; then
  actual="$(sha256sum "$archive" | cut -d' ' -f1)"
else
  actual="$(shasum -a 256 "$archive" | cut -d' ' -f1)"
fi

if [ "$actual" != "$expected" ]; then
  echo "Checksum mismatch for $asset" >&2
  echo "  expected: $expected" >&2
  echo "  actual:   $actual" >&2
  exit 1
fi

tar -xzf "$archive" -C "$dest"
