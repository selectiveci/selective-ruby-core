#!/bin/bash

set -euo pipefail

TRANSPORT_REF=v0.3.0

os=${1:-$(uname -s)}
arch=${2:-$(uname -m)}

if [ "$os" = "Darwin" ] && [ "$arch" = "arm64" ]; then
  arch="aarch64"
fi

if [ "$os" != "Darwin" ] && [ "$os" != "Linux" ]; then
  echo "Unsupported OS" >&2
  exit 1
fi

if [ "$arch" != "aarch64" ] && [ "$arch" != "x86_64" ]; then
  echo "Unsupported Architecture" >&2
  exit 1
fi

asset="transport-${os}-${arch}.tar.gz"

case "$asset" in
  transport-Darwin-aarch64.tar.gz) expected=dc5e7fff627041d304ab88aabb21bbdb167a56a21d71c38b2850fc52d6cccd3c ;;
  transport-Darwin-x86_64.tar.gz) expected=5f491c35d150e6594b4a81070060600af6721a1b558e0cdd2c47712027bb7ed2 ;;
  transport-Linux-aarch64.tar.gz) expected=7ff36a36c78347de37154f6eb461f425b9c7f87b5387d0288162092c6f54090c ;;
  transport-Linux-x86_64.tar.gz) expected=9a14ceee175a821977aedc69bfcbd9610ff369368a66274bdb64dbb5176bdc8d ;;
esac

root="$(cd "$(dirname "$0")/.." && pwd)"
dest="$root/lib/bin"
archive="$root/tmp/$asset"
mkdir -p "$dest" "$root/tmp"
trap 'rm -f "$archive"' EXIT

curl -L --fail --silent --show-error \
  "https://github.com/selectiveci/transport/releases/download/${TRANSPORT_REF}/${asset}" \
  -o "$archive"

if command -v sha256sum >/dev/null 2>&1; then
  actual="$(sha256sum "$archive" | cut -d' ' -f1)"
else
  actual="$(shasum -a 256 "$archive" | cut -d' ' -f1)"
fi

if [ "$actual" != "$expected" ]; then
  echo "Checksum mismatch for $asset" >&2
  echo "  expected: $expected" >&2
  echo "  actual:   $actual" >&2
  exit 1
fi

tar -xzf "$archive" -C "$dest"
