#!/bin/bash

set -euo pipefail

TRANSPORT_REF=c728f92e64009329cfab7d85e6de37e90416e805

os=${1:-$(uname -s)}
arch=${2:-$(uname -m)}

if [ "$os" = "Darwin" ] && [ "$arch" = "arm64" ]; then
  arch="aarch64"
fi

if [ "$os" != "Darwin" ] && [ "$os" != "Linux" ]; then
  echo "Unsupported OS" >&2
  exit 1
fi

if [ "$arch" != "aarch64" ] && [ "$arch" != "x86_64" ]; then
  echo "Unsupported Architecture" >&2
  exit 1
fi

root="$(cd "$(dirname "$0")/.." && pwd)"
dest="$root/lib/bin"
mkdir -p "$dest" "$root/tmp"

if [[ "$TRANSPORT_REF" == v* ]]; then
  archive="$root/tmp/transport.tar.gz"
  curl -L --fail --silent --show-error \
    "https://github.com/selectiveci/transport/releases/download/${TRANSPORT_REF}/transport-${os}-${arch}.tar.gz" \
    -o "$archive"
  tar -xzf "$archive" -C "$dest"
  rm "$archive"
  exit 0
fi

host_os="$(uname -s)"
host_arch="$(uname -m)"
if [ "$host_os" = "Darwin" ] && [ "$host_arch" = "arm64" ]; then
  host_arch="aarch64"
fi

if [ "$os" != "$host_os" ] || [ "$arch" != "$host_arch" ]; then
  echo "TRANSPORT_REF ${TRANSPORT_REF} is a commit, so only the host binary can be built. Set it to a release tag to fetch ${os} ${arch}." >&2
  exit 1
fi

src="$root/tmp/transport-src"
if [ ! -d "$src/.git" ]; then
  git init -q "$src"
  git -C "$src" remote add origin https://github.com/selectiveci/transport
fi
git -C "$src" fetch --depth 1 -q origin "$TRANSPORT_REF"
git -C "$src" checkout -q --force FETCH_HEAD
cargo build --release --manifest-path "$src/Cargo.toml"
cp "$src/target/release/transport" "$dest/transport"
chmod +x "$dest/transport"
