#!/usr/bin/env bash
set -euo pipefail

dir="$1"
runners_per_cell="$2"
status=0

shopt -s nullglob
files=("$dir"/*.txt)
if (( ${#files[@]} == 0 )); then
  echo "no runner counts found in $dir" >&2
  exit 1
fi

declare -A ran suite runners
for file in "${files[@]}"; do
  name=$(basename "$file" .txt)
  cell=${name%-*}
  read -r count size <"$file"
  ran[$cell]=$(( ${ran[$cell]:-0} + count ))
  runners[$cell]=$(( ${runners[$cell]:-0} + 1 ))
  if (( size > ${suite[$cell]:-0} )); then
    suite[$cell]=$size
  fi
done

for cell in $(printf '%s\n' "${!ran[@]}" | sort -V); do
  line="Ruby $cell: ${ran[$cell]} of ${suite[$cell]} examples across ${runners[$cell]} runners"
  if (( runners[$cell] != runners_per_cell || suite[$cell] == 0 || ran[$cell] < suite[$cell] )); then
    echo "FAIL $line"
    status=1
  else
    echo "ok   $line"
  fi
done

exit "$status"
